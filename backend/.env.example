# ===== Milvus 向量库 =====
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=doc_collection

# ===== Embedding (硅基流动 / OpenAI 兼容) =====
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=sk-your-siliconflow-key
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5

# ===== LLM 提供商 =====
# 可选: siliconflow | openai | deepseek | custom
LLM_PROVIDER=siliconflow
LLM_API_KEY=sk-your-key
# siliconflow 示例模型: deepseek-ai/DeepSeek-V3, Qwen/Qwen2.5-72B-Instruct
LLM_MODEL=deepseek-ai/DeepSeek-V3
# 仅在 LLM_PROVIDER=custom 时需要
LLM_BASE_URL=
LLM_TEMPERATURE=0.1

# ===== 检索与分块参数 =====
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=5

# ===== 上传限制 =====
MAX_UPLOAD_MB=20
