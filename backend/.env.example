# ===== Milvus 向量库 =====
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=doc_collection

# ===== Embedding (硅基流动 / OpenAI 兼容) =====
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=sk-your-siliconflow-key
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5

# ===== Rerank 重排序 (默认复用 Embedding 的 base_url 与 key) =====
# RERANK_ENABLED=false 可关闭重排（恢复更快的首 token 响应）
RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_API_KEY=sk-your-siliconflow-key

# ===== LLM 提供商 =====
# 可选: siliconflow | openai | deepseek | custom
LLM_PROVIDER=siliconflow
LLM_API_KEY=sk-your-key
# siliconflow 示例模型: deepseek-ai/DeepSeek-V3, Qwen/Qwen2.5-72B-Instruct
LLM_MODEL=deepseek-ai/DeepSeek-V3
# 仅在 LLM_PROVIDER=custom 时需要
LLM_BASE_URL=
LLM_TEMPERATURE=0.1

# ===== RAGAS 测试集生成（scripts/generate_testset.py）=====
# transforms（Summary/NER 抽取）用快模型跑（比主 LLM 便宜的模型），主 LLM 仍用于问题合成。
# RAGAS_FAST_LLM_MODEL 未设置时回落 LLM_MODEL；BASE_URL/API_KEY 未设置时复用主 LLM 的配置
RAGAS_FAST_LLM_MODEL=
RAGAS_FAST_LLM_BASE_URL=
RAGAS_FAST_LLM_API_KEY=

# ===== 检索与分块参数 =====
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=5
# 切分策略：auto 短文档(<3000字符)语义切分/长文档固定切分；true 全语义；false 全固定
SEMANTIC_SPLIT=auto
AUTO_SEMANTIC_THRESHOLD=3000
# 检索前 Query 增强（LLM 改写 + HYDE 假想答案）
QUERY_TRANSFORM=true
HYDE=true

# ===== 上传限制 =====
MAX_UPLOAD_MB=20

# ── 多 agent 研究助理工作台 ──
# 联网搜索（tavily 或 bocha；不配 key 则 Search agent 降级）
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=
# 数据分析子进程超时（秒）
DATA_EXEC_TIMEOUT=30
# supervisor 最大决策轮数
AGENT_MAX_TURNS=8
